{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 4,
    "modules-left": ["custom/logo", "hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "network", "bluetooth", "pulseaudio", "battery", "custom/power", "tray"],
    "custom/logo": {
        "format": "\uf303",
        "on-click": "wofi --show drun",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "\u25cf",
            "default": "\u25cb",
            "empty": "\u25cb"
        },
        "persistent-workspaces": { "*": 5 }
    },
    "clock": {
        "format": "\uf017  {0:%H:%M}   {0:%d %b}",
        "tooltip-format": "{0:%A, %d de %B de %Y}"
    },
    "cpu": {
        "format": "\uf2db  {usage}%",
        "interval": 3,
        "on-click": "kitty --class btop -e btop"
    },
    "memory": {
        "format": "\uf233  {percentage}%",
        "interval": 3,
        "on-click": "kitty -e btop"
    },
    "network": {
        "format-wifi": "\uf1eb  {essid}",
        "format-ethernet": "\uf0e8  Cabo",
        "format-disconnected": "\uf00d  Offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}  ({signalStrength}%)",
        "on-click": "kitty --class wlctl -e wlctl"
    },
    "bluetooth": {
        "format": "\uf293",
        "format-disabled": "\uf293",
        "format-connected": "\uf293  {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "kitty --class bluetui -e bluetui"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "\uf026  Mudo",
        "format-icons": { "default": ["\uf026", "\uf027", "\uf028"] },
        "on-click": "kitty --class wiremix -e wiremix",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "battery": {
        "format": "{icon}  {capacity}%",
        "format-charging": "\uf0e7  {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "format-critical": "\uf244  {capacity}%"
    },
    "custom/power": {
        "format": "\uf011",
        "tooltip": false,
        "on-click": "bash ~/.config/hypr/scripts/powermenu.sh"
    },
    "tray": {
        "spacing": 12,
        "icon-size": 16
    }
}
