#!/usr/bin/env python3
# Lista os atalhos do Hyprland com busca, via Vicinae dmenu (WIN+K).
# Lê ao vivo do `hyprctl binds -j`: a lista nunca desatualiza. Em config Lua o
# JSON só traz a descrição (`desc` no bind), então bind sem desc aparece marcado.
# Específico do Hyprland (a fonte é o hyprctl); a exibição é agnóstica.
import json
import subprocess

MODS = [(64, "WIN"), (4, "CTRL"), (8, "ALT"), (1, "SHIFT")]
TECLAS = {
    "mouse_up": "scroll ↑", "mouse_down": "scroll ↓",
    "mouse:272": "clique esq.", "mouse:273": "clique dir.",
    "left": "←", "right": "→", "up": "↑", "down": "↓",
}


def combo(b):
    partes = [nome for bit, nome in MODS if b["modmask"] & bit]
    tecla = b["key"]
    tecla = TECLAS.get(tecla, tecla.removeprefix("XF86"))
    return " + ".join(partes + [tecla])


binds = json.loads(subprocess.run(["hyprctl", "binds", "-j"],
                                  capture_output=True, text=True, check=True).stdout)
# WIN primeiro (workspaces 0-9 no fim do bloco), depois Print e teclas de mídia
binds.sort(key=lambda b: (not b["modmask"] & 64, b["key"].isdigit(), combo(b)))
linhas = [(combo(b), b["description"] or "(sem descrição)") for b in binds]
largura = max(len(c) for c, _ in linhas)
texto = "\n".join(f"{c.ljust(largura)}   {d}" for c, d in linhas)

subprocess.run(["vicinae", "dmenu", "-n", "atalhos", "-p", "buscar atalho",
                "-s", "{count} atalhos", "--no-quick-look", "-W", "720", "-H", "560"],
               input=texto, text=True, stdout=subprocess.DEVNULL)
