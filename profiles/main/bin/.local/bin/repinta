#!/bin/sh
# Repinta o desktop a partir do preset ativo do kitty: cor-atual.conf e
# fonte-atual.conf são a fonte da verdade, o resto é gerado daqui.
# Chamado pelo `cor` e pelo `fonte`; o setup.sh roda na instalação.
# Gera arquivos *-atual (estado local, fora do git) e recarrega quem está de pé.
#
# Papéis da paleta: fundo = background, texto = foreground,
# ativo = color7, apagado/borda = color8, erro = color9, ok = color10.
set -e

kitty="$HOME/.config/kitty"
cor="$kitty/cor-atual.conf"
fonte="$kitty/fonte-atual.conf"
nome=$(basename "$(readlink "$cor")" .conf)

# Valor de uma chave no formato do kitty ("chave valor")
val() { awk -v k="$1" '$1 == k { $1 = ""; sub(/^ +/, ""); print; exit }' "$2"; }
# Hex sem o '#'
h() { echo "$1" | tr -d '#'; }

bg=$(val background "$cor")
fg=$(val foreground "$cor")
ativo=$(val color7 "$cor")
dim=$(val color8 "$cor")
erro=$(val color9 "$cor")
ok=$(val color10 "$cor")
font=$(val font_family "$fonte")
size=$(val font_size "$fonte")

# Hyprland: bordas das janelas
cat >"$HOME/.config/hypr/cor-atual.lua" <<EOF
-- Gerado pelo repinta (paleta $nome). Não editar: troque com \`cor\`.
hl.config({ general = { col = {
    active_border   = "rgb($(h "$ativo"))",
    inactive_border = "rgb($(h "$dim"))",
} } })
EOF

# kitty: abas e bordas de split (o resto da paleta já vem do cor-atual.conf)
cat >"$kitty/abas-atual.conf" <<EOF
# Gerado pelo repinta (paleta $nome). Não editar.
tab_bar_background $bg
active_tab_foreground $bg
active_tab_background $ativo
active_tab_font_style normal
inactive_tab_foreground $dim
inactive_tab_background $bg
inactive_tab_font_style normal
active_border_color $ativo
inactive_border_color $dim
EOF

# hyprlock: variáveis lidas pelo hyprlock.conf (vale no próximo lock)
cat >"$HOME/.config/hypr/hyprlock-atual.conf" <<EOF
# Gerado pelo repinta (paleta $nome). Não editar.
\$bg = rgb($(h "$bg"))
\$fg = rgb($(h "$fg"))
\$dim = rgb($(h "$dim"))
\$erro = rgb($(h "$erro"))
\$ok = rgb($(h "$ok"))
\$font = $font
EOF

# waybar: o style.css importa este
cat >"$HOME/.config/waybar/tema-atual.css" <<EOF
/* Gerado pelo repinta (paleta $nome). Não editar. */
@define-color bg $bg;
@define-color fg $fg;
@define-color ativo $ativo;
@define-color dim $dim;
@define-color erro $erro;
* { font-family: "$font"; font-size: ${size}pt; }
EOF

# mako: incluído no fim do config
mkdir -p "$HOME/.config/mako"
cat >"$HOME/.config/mako/tema-atual" <<EOF
# Gerado pelo repinta (paleta $nome). Não editar.
font=$font $size
background-color=$bg
text-color=$fg
border-color=$dim
progress-color=over $dim

[urgency=critical]
border-color=$erro
EOF

# Vicinae: tema gerado da paleta + fonte, via "imports" do settings.json
cat >"$HOME/.local/share/vicinae/themes/tema-atual.toml" <<EOF
# Gerado pelo repinta (paleta $nome). Não editar.
[meta]
version = 1
name = "atual ($nome)"
description = "Paleta $nome, gerada do kitty"
variant = "dark"

[colors.core]
background = "$bg"
foreground = "$fg"
secondary_background = "$bg"
border = "$dim"
accent = "$ativo"
accent_foreground = "$bg"

[colors.accents]
blue = "$(val color12 "$cor")"
green = "$ok"
magenta = "$(val color13 "$cor")"
orange = "$(val color3 "$cor")"
purple = "$(val color5 "$cor")"
red = "$erro"
yellow = "$(val color11 "$cor")"
cyan = "$(val color14 "$cor")"

[colors.input]
border = "$dim"
border_focus = "$ativo"
border_error = "$erro"

[colors.list.item.selection]
background = "$ativo"
foreground = "$bg"
secondary_background = "$dim"
secondary_foreground = "$fg"

[colors.grid.item]
background = "$bg"
EOF
cat >"$HOME/.config/vicinae/tema-atual.json" <<EOF
{
	"font": { "normal": { "family": "$font", "size": $size } },
	"theme": {
		"light": { "name": "tema-atual", "icon_theme": "auto" },
		"dark":  { "name": "tema-atual", "icon_theme": "auto" }
	}
}
EOF

# Firefox: o userChrome.css importa este (vale no próximo start do Firefox)
ffchrome="$HOME/.config/mozilla/firefox/chrome"
if [ -d "$ffchrome" ]; then
    cat >"$ffchrome/tema-atual.css" <<EOF
/* Gerado pelo repinta (paleta $nome). Não editar. */
:root {
    --uc-bg: $bg;
    --uc-fg: $fg;
    --uc-ativo: $ativo;
    --uc-dim: $dim;
    --uc-ok: $ok;
    --uc-font: "$font";
    --uc-size: ${size}pt;
}
EOF
fi

# Neovim: paleta base16 pro mini.base16 (lua/plugins/tema.lua). Sintaxe nas
# cores claras (8-15): as escuras somem no fundo preto. base01 (linha do
# cursor, barras) é um terço do caminho entre fundo e apagado, porque o color0
# costuma ser igual ao fundo.
mix() {
    a=$(h "$1"); b=$(h "$2")
    for i in 1 3 5; do
        x=$(printf '%d' "0x$(echo "$a" | cut -c$i-$((i + 1)))")
        y=$(printf '%d' "0x$(echo "$b" | cut -c$i-$((i + 1)))")
        printf '%02x' $(((2 * x + y) / 3))
    done
}
cat >"$HOME/.config/nvim/lua/tema-atual.lua" <<EOF
-- Gerado pelo repinta (paleta $nome). Não editar: troque com \`cor\`.
return {
  base00 = "$bg", base01 = "#$(mix "$bg" "$dim")",
  base02 = "$dim", base03 = "$dim",
  base04 = "$ativo", base05 = "$fg",
  base06 = "$(val color15 "$cor")", base07 = "$(val color15 "$cor")",
  base08 = "$erro", base09 = "$(val color3 "$cor")",
  base0A = "$(val color11 "$cor")", base0B = "$ok",
  base0C = "$(val color14 "$cor")", base0D = "$(val color12 "$cor")",
  base0E = "$(val color13 "$cor")", base0F = "$(val color1 "$cor")",
}
EOF

# Wallpaper: tela de boot na paleta (fundo-atual.png, gerado pelo `fundo`);
# a cor sólida fica de reserva pro autostart.sh se o PNG faltar
h "$bg" >"$HOME/.config/session/fundo-atual"
fundo regera >/dev/null || true

# Recarrega o que estiver rodando
pkill -USR1 -x kitty || true
pgrep -x waybar >/dev/null && pkill -USR2 -x waybar
pgrep -x mako >/dev/null && makoctl reload
pgrep -x awww-daemon >/dev/null && awww img "$HOME/.config/session/fundo-atual.png"
if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then hyprctl reload >/dev/null; fi
# Vicinae relê o tema-atual.json sozinho (fonte), mas o tema tem sempre o
# mesmo nome: só relê o .toml com o `theme set`
# Neovim: cada instância abre um socket em $XDG_RUNTIME_DIR/nvim.<pid>.0
for sock in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/nvim.*.0; do
    [ -S "$sock" ] && nvim --server "$sock" --remote-expr 'execute("lua Repinta()")' >/dev/null 2>&1 || true
done
pgrep -x vicinae-server >/dev/null && vicinae theme set tema-atual >/dev/null 2>&1 || true
echo "repinta: $nome + $font $size"
