#!/bin/sh
# Repinta o desktop a partir do modo e da paleta ativos (~/.config/tema/):
#   modo-atual.conf -> modos/terminal.conf | modos/desktop.conf  (`modo`)
#   cor-atual.conf  -> paletas/<nome>.conf, paleta do Terminal Mode (`cor`)
#   kitty/fonte-atual.conf -> fonte do Terminal Mode (`fonte`)
# No Desktop Mode paleta e fonte vêm do modos/desktop.conf.
# O modo troca FORMA e COR: além das cores, cada app aponta pra sua forma
# (symlink *-forma-atual -> formas/<modo>.*) quando a forma do modo existe.
# Chamado pelo `modo`, `cor` e `fonte`; o setup.sh roda na instalação.
# Gera arquivos *-atual (estado local, fora do git) e recarrega quem está de pé.
#
# Papéis (paletas/*.conf): fundo-fundo, fundo-barra, fundo, superficie, borda,
# apagado, texto-2, texto, destaque, destaque-2, icone, info, ok, aviso,
# numero, erro (+ color0..15 do terminal). Nas paletas do Terminal Mode os
# papéis são as cores ANSI de sempre, então o modo sai idêntico.
set -e

tema="$HOME/.config/tema"
kitty="$HOME/.config/kitty"

# Valor de uma chave no formato "chave valor"
val() { awk -v k="$1" '$1 == k { $1 = ""; sub(/^ +/, ""); print; exit }' "$2"; }
# Hex sem o '#'
h() { echo "$1" | tr -d '#'; }
# Hex + alpha (0-1) -> rgba(r,g,b,a), pro CSS do GTK
rgba() {
    x=$(h "$1")
    printf 'rgba(%d,%d,%d,%s)' "0x$(echo "$x" | cut -c1-2)" "0x$(echo "$x" | cut -c3-4)" "0x$(echo "$x" | cut -c5-6)" "$2"
}
# Hex + alpha (0-1) -> #AARRGGBB (Qt: Vicinae)
argb() { printf '#%02x%s' "$(awk -v a="$2" 'BEGIN { printf "%d", a * 255 + 0.5 }')" "$(h "$1")"; }
# Hex + alpha (0-1) -> RRGGBBAA (hyprlock rgba(), mako #RRGGBBAA)
hexa() { printf '%s%02x' "$(h "$1")" "$(awk -v a="$2" 'BEGIN { printf "%d", a * 255 + 0.5 }')"; }
# $1 por cima de $2 com alpha $3 (0-1) -> #hex sólido (pra onde só cabe cor chapada)
blend() {
    f=$(h "$1"); b=$(h "$2")
    printf '#'
    for i in 1 3 5; do
        fc=$(printf '%d' "0x$(echo "$f" | cut -c$i-$((i + 1)))")
        bc=$(printf '%d' "0x$(echo "$b" | cut -c$i-$((i + 1)))")
        awk -v f="$fc" -v b="$bc" -v a="$3" 'BEGIN { printf "%02x", f * a + b * (1 - a) + 0.5 }'
    done
}

modo=$(basename "$(readlink "$tema/modo-atual.conf" 2>/dev/null)" .conf)
[ -n "$modo" ] || modo=terminal
if [ "$modo" = desktop ]; then
    nome=$(val paleta "$tema/modos/desktop.conf")
    pal="$tema/paletas/$nome.conf"
    font=$(val fonte "$tema/modos/desktop.conf")
    size=$(val tamanho "$tema/modos/desktop.conf")
else
    pal="$tema/cor-atual.conf"
    nome=$(basename "$(readlink "$pal")" .conf)
    fonte="$kitty/fonte-atual.conf"
    font=$(val font_family "$fonte")
    size=$(val font_size "$fonte")
fi
# Paleta resolvida, pra quem lê papéis fora daqui (fundo, prompt)
cp "$pal" "$tema/paleta-atual.conf"

p() { val "$1" "$pal"; }
c() { val "color$1" "$pal"; }
bg=$(p fundo)
fg=$(p texto)
ativo=$(p destaque)
dim=$(p apagado)
borda=$(p borda)
erro=$(p erro)
ok=$(p ok)
aviso=$(p aviso)
# Desktop Mode: papéis que só ele usa
fundofundo=$(p fundo-fundo)
barra=$(p fundo-barra)
sup=$(p superficie)
t2=$(p texto-2)
d2=$(p destaque-2)
icone=$(p icone)
info=$(p info)
numero=$(p numero)
# pt -> px (96 dpi)
px() { awk -v s="$1" 'BEGIN { printf "%d", s * 4 / 3 }'; }

# Forma do app no modo: <dir>/<link> -> formas/<modo>.<ext> (terminal se o
# modo não tiver forma própria pra esse app)
forma() {
    dir=$1 link=$2 ext=$3
    f="formas/$modo.$ext"
    [ -e "$dir/$f" ] || f="formas/terminal.$ext"
    ln -sfn "$f" "$dir/$link"
}

# --- kitty: paleta (cor-atual.conf, lido também pelo `fundo`) + tema-atual.conf
# (fonte, paleta, abas e o que for do modo). O cor-atual.conf era symlink pro
# preset: remove antes, senão o > escreveria em cima do preset
rm -f "$kitty/cor-atual.conf" "$kitty/abas-atual.conf"
{
    echo "# Gerado pelo repinta (paleta $nome). Não editar: troque com \`cor\` / \`modo\`."
    echo "background $bg"
    echo "foreground $fg"
    for k in cursor cursor_text_color selection_background selection_foreground; do
        v=$(p "$k"); [ -n "$v" ] && echo "$k $v"
    done
    for i in $(seq 0 15); do echo "color$i $(c "$i")"; done
} >"$kitty/cor-atual.conf"
if [ "$modo" = desktop ]; then
    cat >"$kitty/tema-atual.conf" <<EOF
# Gerado pelo repinta (modo desktop, paleta $nome). Não editar.
font_family      $font
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        $size
include cor-atual.conf
# Respiro do texto dentro da janela (pt; 18x20 px no mockup)
window_padding_width 13.5 15
tab_bar_background $barra
active_tab_foreground $fundofundo
active_tab_background $ativo
active_tab_font_style bold
inactive_tab_foreground $dim
inactive_tab_background $barra
inactive_tab_font_style normal
active_border_color $ativo
inactive_border_color $borda
EOF
else
    {
        echo "# Gerado pelo repinta (modo terminal, paleta $nome). Não editar."
        grep -v '^#' "$fonte"
        cat <<EOF
include cor-atual.conf
window_padding_width 4
tab_bar_background $bg
active_tab_foreground $bg
active_tab_background $ativo
active_tab_font_style normal
inactive_tab_foreground $dim
inactive_tab_background $bg
inactive_tab_font_style normal
active_border_color $ativo
inactive_border_color $borda
EOF
    } >"$kitty/tema-atual.conf"
fi

# --- Hyprland: cores+borda (cor-atual.lua) e forma do modo (forma-atual.lua,
# carregado pelo hyprland.lua depois do espaco-atual, então ganha dele no
# Desktop Mode; no Terminal Mode manda o espaco).
hypr="$HOME/.config/hypr"
if [ "$modo" = desktop ]; then
    # Borda ativa em degradê 45° destaque -> destaque-2; inativa sólida.
    cat >"$hypr/cor-atual.lua" <<EOF
-- Gerado pelo repinta (modo desktop, paleta $nome). Não editar: troque com \`modo\`.
hl.config({ general = { col = {
    active_border   = { colors = { "rgb($(h "$ativo"))", "rgb($(h "$d2"))" }, angle = 45 },
    inactive_border = "rgb($(h "$borda"))",
} } })
EOF
    # Forma: cantos 6 (interno 4 pela borda 2), gaps 6/12, sombra de flutuante,
    # entrada popin 90% ~300ms easeOutQuint. Sombra global ligada (o que flutua
    # ganha); rules.lua tira dos lado-a-lado (no_shadow em float=false).
    cat >"$hypr/forma-atual.lua" <<EOF
-- Gerado pelo repinta (modo desktop). Não editar: troque com \`modo\`.
hl.config({
    general = { border_size = 2, gaps_in = 6, gaps_out = 12 },
    decoration = {
        rounding = 6,
        rounding_power = 2,
        active_opacity = 1.0, inactive_opacity = 1.0,
        shadow = { enabled = true, range = 40, render_power = 2, offset = { 0, 18 }, color = "rgba(0,0,0,0.55)" },
        blur = { enabled = false },
    },
})
hl.animation({ leaf = "windowsIn",  enabled = true, speed = 4.1, bezier = "easeOutQuint", style = "popin 90%" })
hl.animation({ leaf = "windowsOut", enabled = true, speed = 4.1, bezier = "easeOutQuint", style = "popin 90%" })
EOF
else
    cat >"$hypr/cor-atual.lua" <<EOF
-- Gerado pelo repinta (modo terminal, paleta $nome). Não editar: troque com \`cor\`.
hl.config({ general = { col = {
    active_border   = "rgb($(h "$ativo"))",
    inactive_border = "rgb($(h "$borda"))",
} } })
EOF
    # Terminal Mode: forma reta (cantos 0, sem sombra, sem blur). O gaps fica
    # a cargo do `espaco`; aqui só zera o resto da decoração.
    cat >"$hypr/forma-atual.lua" <<EOF
-- Gerado pelo repinta (modo terminal). Não editar: troque com \`modo\`.
hl.config({
    general = { border_size = 1 },
    decoration = {
        rounding = 0,
        active_opacity = 1.0, inactive_opacity = 1.0,
        shadow = { enabled = false },
        blur = { enabled = false },
    },
})
hl.animation({ leaf = "windowsIn",  enabled = true, speed = 4.1, spring = "easy", style = "popin 87%" })
hl.animation({ leaf = "windowsOut", enabled = true, speed = 1.49, bezier = "linear", style = "popin 87%" })
EOF
fi

# --- waybar: o style.css importa o tema-atual.css (cores+fonte). As variáveis
# extras (barra, superfície, papéis coloridos) só o Desktop Mode usa.
cat >"$HOME/.config/waybar/tema-atual.css" <<EOF
/* Gerado pelo repinta (paleta $nome, modo $modo). Não editar. */
@define-color bg $bg;
@define-color fg $fg;
@define-color ativo $ativo;
@define-color dim $dim;
@define-color erro $erro;
@define-color barra $barra;
@define-color sup $sup;
@define-color borda $borda;
@define-color t2 $t2;
@define-color d2 $d2;
@define-color icone $icone;
@define-color info $info;
@define-color ok $ok;
@define-color aviso $aviso;
@define-color numero $numero;
* { font-family: "$font"; font-size: ${size}pt; }
EOF
# Forma da barra por modo: layout (config-atual.jsonc) + estilo (forma-atual.css).
# O style.css importa forma-atual.css; o config.jsonc inclui config-atual.jsonc.
forma "$HOME/.config/waybar" forma-atual.css  css
forma "$HOME/.config/waybar" config-atual.jsonc jsonc

# --- mako: incluído no fim do config (abre a seção [urgency=critical]). O que
# vem aqui sobrescreve os globais do config (o include é lido depois), então a
# FORMA por modo mora aqui: Desktop = cartão raio 8, borda a 12%, ícone 36 px
# arredondado; Terminal = reto, sem ícone (como antes). mako não tem sombra.
mkdir -p "$HOME/.config/mako"
if [ "$modo" = desktop ]; then
    cat >"$HOME/.config/mako/tema-atual" <<EOF
# Gerado pelo repinta (paleta $nome, modo $modo). Não editar.
font=$font $size
background-color=$bg
text-color=$fg
border-color=#$(hexa "$fg" 0.12)
progress-color=over $sup
border-radius=8
border-size=1
padding=14
margin=12
icons=1
max-icon-size=36
icon-border-radius=8
width=380

[urgency=critical]
border-color=$erro
EOF
else
    cat >"$HOME/.config/mako/tema-atual" <<EOF
# Gerado pelo repinta (paleta $nome, modo $modo). Não editar.
font=$font $size
background-color=$bg
text-color=$fg
border-color=$borda
progress-color=over $borda

[urgency=critical]
border-color=$erro
EOF
fi

# --- swayosd: OSD de volume/brilho (ícone + barra). CSS por modo: Desktop =
# cartão base, cantos 8, ícone no destaque, trilho surface0 + barra destaque;
# Terminal = reto, nas cores da paleta. Vale quando o swayosd-server reinicia
# (o repinta reinicia na troca de modo).
mkdir -p "$HOME/.config/swayosd"
if [ "$modo" = desktop ]; then
    osd_round=8; osd_track="$sup"; osd_iconsz=20
else
    osd_round=0; osd_track="$borda"; osd_iconsz=18
fi
cat >"$HOME/.config/swayosd/style.css" <<EOF
/* Gerado pelo repinta (paleta $nome, modo $modo). Não editar. */
window {
    background: transparent;
}
#osd {
    padding: 12px 16px;
    border-radius: ${osd_round}px;
    border: 1px solid $(rgba "$fg" 0.12);
    background-color: $bg;
}
#container { margin: 0; }
image {
    min-width: ${osd_iconsz}px;
    min-height: ${osd_iconsz}px;
    color: $ativo;
    margin-right: 12px;
}
label { color: $fg; margin-left: 10px; }
progressbar {
    min-height: 6px;
    border-radius: 3px;
    background: $osd_track;
    border: none;
}
progress {
    min-height: 6px;
    border-radius: 3px;
    background-color: $ativo;
}
trough {
    min-height: 6px;
    border-radius: 3px;
    background: $osd_track;
    border: none;
}
EOF

# --- hyprlock: cores + forma por modo (lidas pelo hyprlock.conf, vale no próximo
# lock). Desktop: campo 236x40, cantos 6, borda 2 px em degradê blue->lavender,
# relógio 72. Terminal: 20%x5%, cantos 0, borda 1 px sólida, relógio 64.
if [ "$modo" = desktop ]; then
    lock_outer="rgba($(hexa "$ativo" 1)) rgba($(hexa "$d2" 1)) 45deg"
    lock_round=6; lock_outline=2; lock_size="236, 40"; lock_clock=72; lock_clock_font="$font"
else
    lock_outer="\$dim"
    lock_round=0; lock_outline=1; lock_size="20%, 5%"; lock_clock=64; lock_clock_font="$font"
fi
cat >"$HOME/.config/hypr/hyprlock-atual.conf" <<EOF
# Gerado pelo repinta (paleta $nome, modo $modo). Não editar.
\$bg = rgb($(h "$bg"))
\$fg = rgb($(h "$fg"))
\$dim = rgb($(h "$dim"))
\$erro = rgb($(h "$erro"))
\$ok = rgb($(h "$ok"))
\$ativo = rgb($(h "$ativo"))
\$font = $font
\$outer = $lock_outer
\$round = $lock_round
\$outline = $lock_outline
\$fieldsize = $lock_size
\$clocksize = $lock_clock
EOF

# --- Vicinae: tema (.toml) + fonte/janela (.json), via "imports" do settings.json.
# A forma da janela (cantos, borda, sombra) mora no .json importado, porque o
# repinta precisa trocá-la por modo (o settings.json não tem mais launcher_window).
# Desktop Mode: janela com cantos 10, borda azul 2 px, sombra; seleção azul a 18%
# chapada (o Vicinae não faz borda/alpha em item de lista). Terminal: reto, como antes.
mkdir -p "$HOME/.local/share/vicinae/themes"
if [ "$modo" = desktop ]; then
    mw_border="$ativo"                       # borda da janela do launcher = azul (decidido)
    sel_bg=$(blend "$ativo" "$bg" 0.18)      # seleção azul a 18% sobre o fundo
    sel_sec="$sup"; grid_bg="$sup"           # tiles em superfície
    win_rounding=10; win_border=2; win_shadow=20
else
    mw_border="$dim"
    sel_bg="$ativo"
    sel_sec="$dim"; grid_bg="$bg"            # idêntico ao que havia
    win_rounding=0; win_border=1; win_shadow=0
fi
cat >"$HOME/.local/share/vicinae/themes/tema-atual.toml" <<EOF
# Gerado pelo repinta (paleta $nome, modo $modo). Não editar.
[meta]
version = 1
name = "atual ($nome)"
description = "Paleta $nome, gerada pelo repinta"
variant = "dark"

[colors.core]
background = "$bg"
foreground = "$fg"
secondary_background = "$barra"
border = "$dim"
accent = "$ativo"
accent_foreground = "$bg"

[colors.main_window]
border = "$mw_border"

[colors.accents]
blue = "$(c 12)"
green = "$ok"
magenta = "$(c 13)"
orange = "$(c 3)"
purple = "$(c 5)"
red = "$erro"
yellow = "$(c 11)"
cyan = "$(c 14)"

[colors.input]
border = "$dim"
border_focus = "$ativo"
border_error = "$erro"

[colors.list.item.selection]
background = "$sel_bg"
foreground = "$fg"
secondary_background = "$sel_sec"
secondary_foreground = "$fg"

[colors.grid.item]
background = "$grid_bg"
EOF
cat >"$HOME/.config/vicinae/tema-atual.json" <<EOF
{
	"font": { "normal": { "family": "$font", "size": $size } },
	"theme": {
		"light": { "name": "tema-atual", "icon_theme": "auto" },
		"dark":  { "name": "tema-atual", "icon_theme": "auto" }
	},
	"launcher_window": {
		"rounding": $win_rounding,
		"material": "none",
		"client_side_decorations": {
			"enabled": true,
			"border_width": $win_border,
			"shadow_size": $win_shadow
		},
		"layer_shell": {
			"layer": "top",
			"keyboard_interactivity": "exclusive",
			"enabled": true
		}
	}
}
EOF

# --- Firefox: o userChrome.css importa este (vale no próximo start)
ffchrome="$HOME/.config/mozilla/firefox/chrome"
if [ -d "$ffchrome" ]; then
    cat >"$ffchrome/tema-atual.css" <<EOF
/* Gerado pelo repinta (paleta $nome, modo $modo). Não editar. */
:root {
    --uc-bg: $bg;
    --uc-fg: $fg;
    --uc-ativo: $ativo;
    --uc-dim: $dim;
    --uc-ok: $ok;
    --uc-font: "$font";
    --uc-size: ${size}pt;
}
EOF
fi

# --- Neovim: paleta base16 pro mini.base16 (lua/tema-atual.lua). base01 (linha
# do cursor, menus) é um terço do caminho fundo -> apagado. Papéis batem com a
# sintaxe do mockup: funções no destaque, campos no destaque-2, operadores no
# info, números no numero, comentário/pontuação no apagado.
mix() {
    a=$(h "$1"); b=$(h "$2")
    for i in 1 3 5; do
        x=$(printf '%d' "0x$(echo "$a" | cut -c$i-$((i + 1)))")
        y=$(printf '%d' "0x$(echo "$b" | cut -c$i-$((i + 1)))")
        printf '%02x' $(((2 * x + y) / 3))
    done
}
if [ "$modo" = desktop ]; then
    # Desktop: base16 à la Catppuccin pelos papéis — funções blue, strings green,
    # números peach, operadores/regex teal, keywords mauve, campos lavender,
    # linha do cursor em superfície (surface0), comentário apagado.
    cat >"$HOME/.config/nvim/lua/tema-atual.lua" <<EOF
-- Gerado pelo repinta (paleta $nome, modo $modo). Não editar: troque com \`cor\`/\`modo\`.
return {
  base00 = "$bg", base01 = "$sup",
  base02 = "$borda", base03 = "$dim",
  base04 = "$t2", base05 = "$fg",
  base06 = "$(c 15)", base07 = "$d2",
  base08 = "$d2", base09 = "$numero",
  base0A = "$aviso", base0B = "$ok",
  base0C = "$info", base0D = "$ativo",
  base0E = "$icone", base0F = "$erro",
}
EOF
else
    # Terminal: base16 das cores ANSI do preset (como sempre).
    cat >"$HOME/.config/nvim/lua/tema-atual.lua" <<EOF
-- Gerado pelo repinta (paleta $nome, modo $modo). Não editar: troque com \`cor\`/\`modo\`.
return {
  base00 = "$bg", base01 = "#$(mix "$bg" "$dim")",
  base02 = "$dim", base03 = "$dim",
  base04 = "$ativo", base05 = "$fg",
  base06 = "$(c 15)", base07 = "$(c 15)",
  base08 = "$erro", base09 = "$(c 3)",
  base0A = "$(c 11)", base0B = "$ok",
  base0C = "$(c 14)", base0D = "$(c 12)",
  base0E = "$(c 13)", base0F = "$(c 1)",
}
EOF
fi

# --- swayimg: init.lua carrega este (0xAARRGGBB; fonte px = pt * 4/3)
mkdir -p "$HOME/.config/swayimg"
cat >"$HOME/.config/swayimg/tema-atual.lua" <<EOF
-- Gerado pelo repinta (paleta $nome, modo $modo). Não editar: troque com \`cor\`/\`modo\`.
return {
  font = "$font", size = $(px "$size"),
  bg = 0xff$(h "$bg"), fg = 0xff$(h "$fg"), ativo = 0xff$(h "$ativo"),
  ok = 0xff$(h "$ok"), mix = 0xff$(mix "$bg" "$dim"),
}
EOF

# --- zathura: o zathurarc faz `include tema-atual` (próximo PDF aberto)
mkdir -p "$HOME/.config/zathura"
cat >"$HOME/.config/zathura/tema-atual" <<EOF
# Gerado pelo repinta (paleta $nome, modo $modo). Não editar.
set font "$font $size"
set default-bg "$bg"
set default-fg "$fg"
set statusbar-bg "$barra"
set statusbar-fg "$fg"
set inputbar-bg "$barra"
set inputbar-fg "$fg"
set notification-bg "$bg"
set notification-fg "$fg"
set notification-error-bg "$bg"
set notification-error-fg "$erro"
set notification-warning-bg "$bg"
set notification-warning-fg "$aviso"
set highlight-color "$borda"
set highlight-active-color "$ok"
set completion-bg "$bg"
set completion-fg "$fg"
set completion-group-bg "$bg"
set completion-group-fg "$dim"
set completion-highlight-bg "$ativo"
set completion-highlight-fg "$fundofundo"
set index-bg "$bg"
set index-fg "$fg"
set index-active-bg "$ativo"
set index-active-fg "$fundofundo"
set recolor-lightcolor "$bg"
set recolor-darkcolor "$fg"
EOF

# --- btop: tema do mockup (tema-atual.theme). O btop.conf é local e o btop o
# reescreve ao sair, então aqui só muda a linha color_theme: Desktop =
# tema-atual, Terminal = Default (como sempre). Vale no próximo btop aberto.
mkdir -p "$HOME/.config/btop/themes"
cat >"$HOME/.config/btop/themes/tema-atual.theme" <<EOF
# Gerado pelo repinta (paleta $nome, modo $modo). Não editar.
theme[main_bg]="$bg"
theme[main_fg]="$fg"
theme[title]="$fg"
theme[hi_fg]="$ativo"
theme[selected_bg]="$sup"
theme[selected_fg]="$ativo"
theme[inactive_fg]="$borda"
theme[graph_text]="$dim"
theme[meter_bg]="$sup"
theme[proc_misc]="$icone"
theme[cpu_box]="$icone"
theme[mem_box]="$ativo"
theme[net_box]="$info"
theme[proc_box]="$borda"
theme[div_line]="$borda"
theme[temp_start]="$ok"
theme[temp_mid]="$aviso"
theme[temp_end]="$numero"
theme[cpu_start]="$ok"
theme[cpu_mid]="$aviso"
theme[cpu_end]="$numero"
theme[free_start]="$info"
theme[free_mid]="$info"
theme[free_end]="$info"
theme[cached_start]="$d2"
theme[cached_mid]="$d2"
theme[cached_end]="$d2"
theme[available_start]="$info"
theme[available_mid]="$info"
theme[available_end]="$info"
theme[used_start]="$ativo"
theme[used_mid]="$ativo"
theme[used_end]="$ativo"
theme[download_start]="$info"
theme[download_mid]="$info"
theme[download_end]="$info"
theme[upload_start]="$icone"
theme[upload_mid]="$icone"
theme[upload_end]="$icone"
theme[process_start]="$ok"
theme[process_mid]="$aviso"
theme[process_end]="$numero"
EOF
btopconf="$HOME/.config/btop/btop.conf"
if [ -f "$btopconf" ]; then
    if [ "$modo" = desktop ]; then bt=tema-atual; else bt=Default; fi
    sed -i "s|^color_theme = .*|color_theme = \"$bt\"|" "$btopconf"
fi

# --- Nautilus (e demais apps libadwaita/GTK4): só as cores-base, sem tema
# completo (spec). Desktop = mocha; Terminal = sem override (Adwaita-dark puro,
# como sempre) — remove o arquivo só se foi gerado aqui. Vale no próximo app aberto.
gtk4="$HOME/.config/gtk-4.0/gtk.css"
if [ "$modo" = desktop ]; then
    mkdir -p "$HOME/.config/gtk-4.0"
    cat >"$gtk4" <<EOF
/* Gerado pelo repinta (paleta $nome, modo desktop). Não editar. */
:root {
  --window-bg-color: $bg;      --window-fg-color: $fg;
  --view-bg-color: $bg;        --view-fg-color: $fg;
  --headerbar-bg-color: $barra; --headerbar-fg-color: $fg;
  --headerbar-backdrop-color: $barra;
  --sidebar-bg-color: $barra;  --sidebar-fg-color: $fg;
  --sidebar-backdrop-color: $barra;
  --secondary-sidebar-bg-color: $barra;
  --card-bg-color: $sup;       --card-fg-color: $fg;
  --dialog-bg-color: $bg;      --dialog-fg-color: $fg;
  --popover-bg-color: $barra;  --popover-fg-color: $fg;
  --thumbnail-bg-color: $sup;
  --accent-bg-color: $ativo;   --accent-fg-color: $fundofundo;  --accent-color: $ativo;
  --destructive-bg-color: $erro; --destructive-color: $erro;
  --success-color: $ok; --warning-color: $aviso; --error-color: $erro;
}
@define-color window_bg_color $bg;
@define-color window_fg_color $fg;
@define-color view_bg_color $bg;
@define-color view_fg_color $fg;
@define-color headerbar_bg_color $barra;
@define-color headerbar_fg_color $fg;
@define-color sidebar_bg_color $barra;
@define-color card_bg_color $sup;
@define-color popover_bg_color $barra;
@define-color dialog_bg_color $bg;
@define-color accent_bg_color $ativo;
@define-color accent_fg_color $fundofundo;
@define-color accent_color $ativo;
EOF
elif [ -f "$gtk4" ] && head -1 "$gtk4" | grep -q 'Gerado pelo repinta'; then
    rm -f "$gtk4"
fi

# --- tmux: tema por modo (tema-atual.conf, lido pelo tmux.conf). ANSI puro, mas
# o destaque muda: Terminal = verde (colour10/colour2), Desktop = azul
# (colour4), com o inativo apagado (colour8). A forma é a mesma.
if [ "$modo" = desktop ]; then
    tac=colour4; tac2=colour4; tmuted=colour8
else
    tac=colour10; tac2=colour2; tmuted=colour2
fi
mkdir -p "$HOME/.config/tmux"
cat >"$HOME/.config/tmux/tema-atual.conf" <<EOF
# Gerado pelo repinta (paleta $nome, modo $modo). Não editar: troque com \`modo\`/\`cor\`.
set -g pane-border-style "fg=colour8"
set -g pane-active-border-style "fg=$tac"
set -g popup-border-style "fg=$tac"
set -g popup-border-lines single
set -g message-style "fg=colour0,bg=$tac"
set -g message-command-style "fg=$tac,bg=colour0"
set -g mode-style "fg=colour0,bg=$tac2"
set -g clock-mode-colour $tac
set -g clock-mode-style 24
set -g display-panes-active-colour $tac
set -g display-panes-colour colour8
set -g status-position top
set -g status-interval 5
set -g status-justify left
set -g status-style "fg=colour7,bg=default"
set -g status-left-length 40
set -g status-right-length 100
set -g status-left "#{?client_prefix,#[fg=colour0 bg=$tac bold],#[fg=colour0 bg=$tac2]} #S #[default]#{?pane_in_mode,#[fg=colour0 bg=colour11] #{pane_mode} #[default],} "
set -g window-status-separator " "
set -g window-status-current-format "#[fg=colour0,bg=$tac,bold] #I #[fg=colour0,bg=colour7,nobold] #W#{?window_zoomed_flag, [z],} #[default]"
set -g window-status-format "#[fg=$tmuted] #I #[fg=colour8]#W#{?window_zoomed_flag, [z],}#{?window_last_flag, -,} #[default]"
set -g window-status-activity-style "fg=colour11"
set -g window-status-bell-style "fg=colour9,bold"
set -g @home "$HOME"
set -g status-right "#[fg=colour8]#{s|^#{@home}|~|:pane_current_path}#[fg=$tmuted]#(cd #{q:pane_current_path} && git branch --show-current 2>/dev/null | sed 's/#/##/g; s/^/  /') "
EOF

# REPINTA_SO_GERA=1: só gera os arquivos, sem mexer no wallpaper nem recarregar
# nada (pra conferir a saída de um modo sem repintar a sessão viva).
if [ -n "$REPINTA_SO_GERA" ]; then
    echo "repinta: modo $modo · paleta $nome · $font $size (só gerou, sem recarregar)"
    exit 0
fi

# --- Wallpaper: cor sólida de reserva (autostart.sh se o PNG faltar). Desktop Mode
# = grade de pontos (fixa do modo). Terminal Mode = o fundo escolhido no `tema
# fundo` (boot/panic/liso), regerado pra pegar kernel/services novos.
h "$bg" >"$HOME/.config/session/fundo-atual"
if [ "$modo" = desktop ]; then
    fundo grade >/dev/null 2>&1 || true
else
    fundo regera >/dev/null 2>&1 || true
    fundo previas >/dev/null 2>&1 &   # cache do seletor (só vale no Terminal Mode)
fi

# --- Recarrega o que estiver de pé
pkill -USR1 -x kitty || true
pgrep -x waybar >/dev/null && pkill -USR2 -x waybar
pgrep -x mako >/dev/null && makoctl reload
# tmux: relê o tema nas sessões vivas (sem subir servidor se não houver) e
# força o redraw da barra (source-file sozinho não repinta a status na hora)
if pgrep -f 'tmux: server' >/dev/null; then
    tmux source-file "$HOME/.config/tmux/tema-atual.conf" >/dev/null 2>&1 || true
    tmux refresh-client -S >/dev/null 2>&1 || true
fi
fundo toca final   # cor nova direto na tela final, sem repetir o boot
if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then hyprctl reload >/dev/null; fi
# Neovim: cada instância abre um socket em $XDG_RUNTIME_DIR/nvim.<pid>.0
for sock in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/nvim.*.0; do
    [ -S "$sock" ] && nvim --server "$sock" --remote-expr 'execute("lua Repinta()")' >/dev/null 2>&1 || true
done
# Servidores que só lêem a forma/tema quando sobem: reiniciam na TROCA DE MODO,
# não numa troca só de cor (evita reindexar/piscar à toa).
aplicado=$(cat "$tema/.modo-aplicado" 2>/dev/null)
# Vicinae: cor recarrega com `theme set`; a forma da janela só no restart.
if pgrep -x vicinae-server >/dev/null; then
    if [ "$aplicado" != "$modo" ]; then
        pkill -x vicinae-server 2>/dev/null || true
        setsid -f vicinae server >/dev/null 2>&1
        # o servidor recém-subido ainda precisa do theme set p/ aplicar o .toml
        (sleep 1.5; vicinae theme set tema-atual >/dev/null 2>&1) &
    else
        vicinae theme set tema-atual >/dev/null 2>&1 || true
    fi
fi
# swayosd: lê o style.css ao subir; reinicia na troca de modo pra pegar a forma
if [ "$aplicado" != "$modo" ] && pgrep -x swayosd-server >/dev/null; then
    pkill -x swayosd-server 2>/dev/null || true
    setsid -f swayosd-server >/dev/null 2>&1
fi
echo "$modo" >"$tema/.modo-aplicado"
echo "repinta: modo $modo · paleta $nome · $font $size"
