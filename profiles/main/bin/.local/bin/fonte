#!/bin/sh
# Troca presets visuais (symlink -> preset) e recarrega quem usa.
# Mesmo script, vários nomes (symlinks em ~/.local/bin):
#   modo   -> ~/.config/tema/modos/    terminal | desktop (repinta: forma + cor)
#   cor    -> ~/.config/tema/paletas/  paleta do Terminal Mode (repinta)
#   fonte  -> ~/.config/kitty/fonts/   fonte do Terminal Mode (repinta)
#   espaco -> ~/.config/hypr/espacos/  gaps do Terminal Mode (hyprctl reload)
# No Desktop Mode cor/fonte/espaco são fixos do modo: a troca fica guardada e
# vale quando voltar pro Terminal Mode.
# Sem argumento lista as opções (* = ativa).
cmd=$(basename "$0")
case "$cmd" in
    modo)   dir="$HOME/.config/tema";  sub=modos;   link=modo-atual.conf;   ext=conf ;;
    cor)    dir="$HOME/.config/tema";  sub=paletas; link=cor-atual.conf;    ext=conf ;;
    espaco) dir="$HOME/.config/hypr";  sub=espacos; link=espaco-atual.lua;  ext=lua ;;
    *)      dir="$HOME/.config/kitty"; sub=fonts;   link=fonte-atual.conf;  ext=conf ;;
esac
atual=$(basename "$(readlink "$dir/$link")" ".$ext")

if [ -z "$1" ]; then
    for f in "$dir/$sub"/*."$ext"; do
        n=$(basename "$f" ".$ext")
        [ "$n" = "$atual" ] && echo "* $n" || echo "  $n"
    done
    exit 0
fi

[ -f "$dir/$sub/$1.$ext" ] || { echo "$cmd: '$1' não existe (rode sem argumento p/ listar)" >&2; exit 1; }
ln -sfn "$sub/$1.$ext" "$dir/$link"
case "$cmd" in
    espaco) hyprctl reload >/dev/null ;;
    *)      "$(dirname "$0")/repinta" >/dev/null ;;
esac
echo "$cmd: $atual -> $1"
modo=$(basename "$(readlink "$HOME/.config/tema/modo-atual.conf")" .conf)
if [ "$cmd" != modo ] && [ "$modo" = desktop ]; then
    echo "  (Desktop Mode ativo: vale quando voltar pro Terminal Mode, com \`modo terminal\`)"
fi
exit 0
