// Barra mínima (Fase 3). Workspaces via ext/workspaces (protocolo Wayland, não
// o IPC do Hyprland: o dispatch antigo da waybar quebra com config Lua); os 1-5
// fixos vêm do rules.lua. Amarrado ao compositor só o
// hyprland/language (layout do teclado; troca com os dois Shifts ou no clique).
// Bateria: avisa em 20%, crítica em 10%.
// Fase 6: clique abre o TUI do módulo (toggle) via ~/.local/bin/tui.
{
    "layer": "top",
    "position": "top",
    "height": 24,
    "modules-left": ["ext/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["hyprland/language", "pulseaudio", "network", "bluetooth", "cpu", "memory", "battery", "custom/energia"],
    "ext/workspaces": { "format": "{name}", "sort-by-id": true, "on-click": "activate" },
    "battery": {
        "states": { "warning": 20, "critical": 10 },
        "format": "bat {capacity}%",
        "format-charging": "bat+ {capacity}%",
        "format-plugged": "ac {capacity}%",
        "tooltip-format": "{timeTo}, {power:.1f}W"
    },
    "hyprland/language": { "format": "{short}", "on-click": "hyprctl switchxkblayout current next" },
    // Relógio: mouse em cima mostra o calendário do mês (hoje sublinhado); clique
    // alterna pra data completa com segundos; botão direito alterna mês/ano no
    // calendário e o scroll navega pelos meses
    "clock": {
        "format": "{:L%a %d/%m  %H:%M}",
        "format-alt": "{:L%A, %d de %B de %Y  %H:%M:%S}",
        "interval": 1,
        "locale": "pt_BR.UTF-8",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "format": { "today": "<b><u>{}</u></b>" }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_down",
            "on-scroll-down": "shift_up"
        }
    },
    "pulseaudio": { "format": "vol {volume}%", "format-muted": "vol mudo", "on-click": "tui wiremix" },
    "network": { "format-ethernet": "eth", "format-wifi": "wifi {essid}", "format-disconnected": "offline", "on-click": "tui nmtui" },
    "bluetooth": { "format": "bt", "format-off": "bt off", "format-disabled": "bt off", "format-connected": "bt {device_alias}", "on-click": "tui bluetui" },
    "cpu": { "format": "cpu {usage}%", "on-click": "tui btop" },
    "memory": { "format": "mem {percentage}%", "on-click": "tui btop" },
    "custom/energia": { "format": "pwr", "tooltip": false, "on-click": "energia" }
}
