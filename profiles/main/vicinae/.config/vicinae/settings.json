{
	"$schema": "https://vicinae.com/schemas/config.json",
	// privacidade: sem telemetria, sem buscar favicon em serviço externo
	"telemetry": { "system_info": false },
	"favicon_service": "none",
	// sem input server: não usa uinput (injeção de teclado); colar vira copiar
	"input_server": { "enabled": false },
	"tray": { "enabled": false },
	"escape_key_behavior": "close_window",
	"font": { "normal": { "family": "CozetteVector", "size": 10 } },
	"theme": {
		"light": { "name": "vga", "icon_theme": "auto" },
		"dark":  { "name": "vga", "icon_theme": "auto" }
	},
	"launcher_window": {
		"material": "none",
		"rounding": 0,
		"client_side_decorations": { "enabled": true, "border_width": 1, "shadow_size": 0 },
		"layer_shell": { "enabled": true, "keyboard_interactivity": "exclusive", "layer": "top" }
	}
}
