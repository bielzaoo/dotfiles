# Notificações na identidade do resto: raio 0, borda 1px, sem ícone.
# Cores e fonte: tema-atual, gerado pelo `repinta` (incluído no fim, porque
# ele abre a seção [urgency=critical]).
anchor=top-right
outer-margin=4
width=360
padding=6,8
border-size=1
border-radius=0
icons=0
default-timeout=5000

include=~/.config/mako/tema-atual

# OSD de volume/brilho (~/.local/bin/osd): no topo ao centro, some rápido.
# Depois do include, que termina dentro de [urgency=critical]
[app-name=osd]
anchor=top-center
width=240
default-timeout=1500
